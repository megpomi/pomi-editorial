{
  "name": "RateLimit",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "title": "Key",
      "description": "Action, caller and time window, combined."
    },
    "kind": {
      "type": "string",
      "title": "Action"
    },
    "count": {
      "type": "number",
      "default": 0,
      "title": "Uses"
    },
    "window_start": {
      "type": "string",
      "format": "date-time",
      "title": "Window start"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}